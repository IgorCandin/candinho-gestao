# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Somente para scripts administrativos locais. Nunca exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Recursos de IA executados somente no servidor.
OPENAI_API_KEY=your_openai_api_key

# Opcional: modelo específico usado pelo Nexus Bank.
OPENAI_BANK_MODEL=gpt-5
