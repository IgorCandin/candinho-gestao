# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Somente para scripts administrativos locais. Nunca exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Recursos de IA executados somente no servidor.
OPENAI_API_KEY=your_openai_api_key

# Opcional: modelo específico usado pelo Nexus Bank.
OPENAI_BANK_MODEL=gpt-5

# Avaliações do Perfil da Empresa no Google. Somente no servidor, sem NEXT_PUBLIC_.
# Requer projeto aprovado para Business Profile APIs e autorização OAuth do administrador.
# Configure os segredos diretamente no ambiente da hospedagem; não envie pelo chat.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_LOCATION=accounts/ACCOUNT_ID/locations/LOCATION_ID
GOOGLE_BUSINESS_MAPS_URL=https://maps.app.goo.gl/jBwJKoXhCydht8Vd8
